# Firebase client config — set these for local dev
# In Cloud Run these are injected by Terraform as runtime env vars
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
API_URL=http://localhost:8080
FIRESTORE_DATABASE=slurp-dev

# Auth emulator — set only for local E2E (must be loopback http)
# FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Custom domain — used in CSP and magic link trusted origins (optional)
APP_URL=

# ── E2E-only (do not set outside local E2E; see docs/testing.md) ────────────
# In E2E the web runs on :3100 with slurp-e2e project and emulator hosts:
# PORT=3100
# FIREBASE_PROJECT_ID=slurp-e2e
# FIREBASE_API_KEY=fake-api-key
# FIREBASE_AUTH_DOMAIN=slurp-e2e.firebaseapp.com
# FIREBASE_APP_ID=1:123:web:e2e
# FIRESTORE_DATABASE=(default)
# FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# API_URL=http://127.0.0.1:8081
# APP_URL=http://127.0.0.1:3100
# GOOGLE_CLOUD_PROJECT=slurp-e2e
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# ENVIRONMENT=e2e
# E2E_RECEIPT_UPLOAD_BASE_URL=http://127.0.0.1:8082

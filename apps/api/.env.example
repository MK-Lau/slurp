# ── Environment ───────────────────────────────────────────────────────────────
# "dev" | "prod"
ENVIRONMENT=dev

# ── Google Cloud / Firebase ───────────────────────────────────────────────────
# GCP project ID
GCP_PROJECT_ID=your-gcp-project-id

# Firestore database name (divide-dev or divide-prod)
FIRESTORE_DATABASE=slurp-dev

# GCS bucket for receipt image uploads
RECEIPT_BUCKET=divide-receipts-dev

# Gemini API key (obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Firebase service account credentials JSON (single line, base64-encoded or raw JSON string)
# Generate via: Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS=

# ── Receipt processing transport ────────────────────────────────────────────────
# When RECEIPT_PROCESSOR_URL is absent, Pub/Sub is used (production default).
# When set, the API POSTs slurpId/gcsPath directly to the processor — only
# allowed for canonical HTTP loopback URLs (http://127.0.0.1:* or
# http://localhost:*) without credentials. Direct mode is permitted only
# when ENVIRONMENT is exactly "local" or "dev" (API direct URL resolver
# allows either with loopback), or exactly "e2e" with the same safe E2E
# invariants required elsewhere (RECEIPT_PARSER=fixture, project slurp-e2e,
# FIRESTORE_EMULATOR_HOST loopback with port). The directly invoked
# processor must run ENVIRONMENT=local to bypass Pub/Sub JWT verification;
# a dev processor expects authenticated Pub/Sub JWT and will reject direct
# POSTs (see apps/receipt-processor/src/config/jwtBypass.ts). In prod,
# missing/unknown ENVIRONMENT, non-loopback, HTTPS, credentialed, or
# ambiguous project config, direct mode refuses and startup throws. For
# local dev with a co-located processor, set:
# RECEIPT_PROCESSOR_URL=http://127.0.0.1:8081  (or http://localhost:8081)
# alongside ENVIRONMENT=local or ENVIRONMENT=dev on the API, but run the
# processor itself with ENVIRONMENT=local (see scripts/dev.sh).

# ── E2E-only (do not set outside ENVIRONMENT=e2e; see docs/testing.md) ────────
# E2E_RECEIPT_UPLOAD_BASE_URL=http://127.0.0.1:8082
# RECEIPT_PARSER=fixture
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# ALLOWED_ORIGINS=http://127.0.0.1:3100
# RECEIPT_PROCESSOR_URL=http://127.0.0.1:8082  # e2e requires full safe runtime; see above

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

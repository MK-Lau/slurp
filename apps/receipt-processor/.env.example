# ── Environment ───────────────────────────────────────────────────────────────
# "dev" | "prod"
ENVIRONMENT=dev

# ── Google Cloud / Firestore ──────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=slurp-dev
RECEIPT_BUCKET=your-receipt-bucket

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── JWT verification ────────────────────────────────────────────────────────────
# The processor's Pub/Sub push endpoint requires JWT verification except:
# - exact ENVIRONMENT=local (legacy local direct POST), or
# - exact ENVIRONMENT=e2e with full safe runtime (RECEIPT_PARSER=fixture,
#   project slurp-e2e, FIRESTORE_EMULATOR_HOST loopback with port).
# Missing/unknown ENVIRONMENT, dev, or prod require normal JWT verification.
# Do not rely on the Processor defaulting missing ENVIRONMENT to local.

# ── E2E-only (do not set outside ENVIRONMENT=e2e; see docs/testing.md) ───────
# In E2E the processor runs on :8082 with slurp-e2e project and emulator hosts:
# PORT=8082
# GOOGLE_CLOUD_PROJECT=slurp-e2e
# FIRESTORE_DATABASE=(default)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# ENVIRONMENT=e2e
# RECEIPT_BUCKET=e2e-receipts
# RECEIPT_PARSER=fixture
